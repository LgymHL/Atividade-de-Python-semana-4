def cadastrar_produtos():
    produtos = []
    print("=== Cadastro de Produtos ===")
    print("Digite 'fim' no campo nome para encerrar o cadastro.\n")

    while True:
        nome = input("Nome do produto: ").strip()
        if nome.lower() == "fim":
            break

        preco_texto = input("Preço do produto: R$ ").strip().replace(",", ".")
        try:
            preco = float(preco_texto)
        except ValueError:
            print("Preço inválido. Use apenas números (ex: 45.90).\n")
            continue

        categoria = input("Categoria do produto: ").strip()

        produtos.append((nome, preco, categoria))
        print(f"✓ {nome} cadastrado com sucesso!\n")

    return produtos


def filtrar_por_preco(produtos, valor, acima=True):
    if acima:
        return [produto for produto in produtos if produto[1] > valor]
    return [produto for produto in produtos if produto[1] < valor]


def ordenar_crescente(produtos):
    produtos.sort(key=lambda produto: produto[1])
    return produtos


def ordenar_decrescente(produtos):
    return sorted(produtos, key=lambda produto: produto[1], reverse=True)


def categorias_unicas(produtos):
    return {produto[2] for produto in produtos}


def calcular_estatisticas(produtos):
    precos = [produto[1] for produto in produtos]
    menor_preco = min(precos)
    maior_preco = max(precos)
    preco_medio = sum(precos) / len(precos)
    return (menor_preco, maior_preco, round(preco_medio, 2))


def exibir_produtos(produtos, titulo="Produtos"):
    print(f"\n--- {titulo} ---")
    if not produtos:
        print("Nenhum produto encontrado.")
        return
    for nome, preco, categoria in produtos:
        print(f"{nome:<20} R$ {preco:>8.2f}   [{categoria}]")


def exibir_relatorio(produtos):
    print("\n" + "=" * 50)
    print("RELATÓRIO FINAL DE PRODUTOS".center(50))
    print("=" * 50)

    exibir_produtos(produtos, "Todos os produtos cadastrados")

    categorias = categorias_unicas(produtos)
    print(f"\nCategorias únicas ({len(categorias)}): {', '.join(sorted(categorias))}")

    menor_preco, maior_preco, preco_medio = calcular_estatisticas(produtos)
    print(f"\nMenor preço : R$ {menor_preco:.2f}")
    print(f"Maior preço : R$ {maior_preco:.2f}")
    print(f"Preço médio : R$ {preco_medio:.2f}")
    print("=" * 50)


def exibir_menu():
    print("\n=== Menu ===")
    print("1. Listar todos os produtos")
    print("2. Filtrar produtos acima de um valor")
    print("3. Filtrar produtos abaixo de um valor")
    print("4. Ordenar por preço (crescente)")
    print("5. Ordenar por preço (decrescente)")
    print("6. Ver categorias únicas")
    print("7. Ver estatísticas (tupla)")
    print("8. Relatório final completo")
    print("0. Sair")


def executar_menu(produtos):
    while True:
        exibir_menu()
        opcao = input("Escolha uma opção: ").strip()

        if opcao == "1":
            exibir_produtos(produtos)

        elif opcao == "2":
            valor = float(input("Valor de referência: R$ "))
            resultado = filtrar_por_preco(produtos, valor, acima=True)
            exibir_produtos(resultado, f"Produtos acima de R$ {valor:.2f}")

        elif opcao == "3":
            valor = float(input("Valor de referência: R$ "))
            resultado = filtrar_por_preco(produtos, valor, acima=False)
            exibir_produtos(resultado, f"Produtos abaixo de R$ {valor:.2f}")

        elif opcao == "4":
            ordenar_crescente(produtos)
            exibir_produtos(produtos, "Produtos ordenados (crescente)")

        elif opcao == "5":
            resultado = ordenar_decrescente(produtos)
            exibir_produtos(resultado, "Produtos ordenados (decrescente)")

        elif opcao == "6":
            categorias = categorias_unicas(produtos)
            print(f"\nCategorias únicas: {categorias}")

        elif opcao == "7":
            menor_preco, maior_preco, preco_medio = calcular_estatisticas(produtos)
            print(f"\nMenor: R$ {menor_preco:.2f} | "
                  f"Maior: R$ {maior_preco:.2f} | "
                  f"Média: R$ {preco_medio:.2f}")

        elif opcao == "8":
            exibir_relatorio(produtos)

        elif opcao == "0":
            print("Encerrando o sistema. Até logo!")
            break

        else:
            print("Opção inválida. Tente novamente.")


def main():
    produtos = cadastrar_produtos()

    if not produtos:
        print("Nenhum produto foi cadastrado. Encerrando o programa.")
        return

    executar_menu(produtos)


if __name__ == "__main__":
    main()

